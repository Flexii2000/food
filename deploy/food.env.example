# Environment file for the food systemd service.
#
# Install as /etc/food.env and lock it down:
#   sudo cp deploy/food.env.example /etc/food.env
#   sudo chown root:food /etc/food.env
#   sudo chmod 640 /etc/food.env
#
# FH_PRIVATE_TOKEN is NOT a token of this app: it is the shared private-mode
# token of fherrmann.com and must match the value in
# /etc/nginx/conf.d/private-mode.conf exactly. deploy/setup-food.sh copies it
# from there so there is only ever one place to change it.

FH_PRIVATE_TOKEN=changeme

# --- Weitere Personen (deploy/setup-health-users.sh schreibt das) -----------
# Je Person ein Token, derselbe steht in /etc/health-viz.env:
#   HEALTH_TOKENS=torben:<openssl rand -hex 24>
# Wer die Schnellerfassung benutzen darf (laeuft auf Felix' Claude-Login);
# leer = nur die Eigentuemerin:
#   FOOD_QUICK_CAPTURE=felix,torben
# Wer die ganze Naehrwerttabelle erfasst (ges. Fettsaeuren, Zucker,
# Ballaststoffe, Salz); leer = niemand:
#   FOOD_DETAILED_NUTRIENTS=torben
# Verzeichnis mit der Android-App (healthy.apk + latest.json):
#   FOOD_ANDROID_DIR=/opt/healthy-android
# Firebase-Dienstkonto fuer Push an Android (root:food 640):
#   FCM_SERVICE_ACCOUNT_FILE=/etc/fcm-healthy.json
