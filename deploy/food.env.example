# Environment file for the food systemd service.
#
# Install as /etc/food.env and lock it down:
#   sudo cp deploy/food.env.example /etc/food.env
#   sudo chown root:food /etc/food.env
#   sudo chmod 640 /etc/food.env
#
# FH_PRIVATE_TOKEN is NOT a token of this app: it is the shared private-mode
# token of fherrmann.com and must match the value in
# /etc/nginx/conf.d/private-mode.conf exactly. deploy/setup-food.sh copies it
# from there so there is only ever one place to change it.

FH_PRIVATE_TOKEN=changeme

# --- Weitere Personen (deploy/setup-health-users.sh schreibt das) -----------
# Je Person ein Token, derselbe steht in /etc/health-viz.env:
#   HEALTH_TOKENS=torben:<openssl rand -hex 24>
# Wer die Schnellerfassung benutzen darf (laeuft auf Felix' Claude-Login);
# leer = nur die Eigentuemerin:
#   FOOD_QUICK_CAPTURE=felix,torben
# Wer die ganze Naehrwerttabelle erfasst (ges. Fettsaeuren, Zucker,
# Ballaststoffe, Salz); leer = niemand:
#   FOOD_DETAILED_NUTRIENTS=torben
# Wer zusaetzlich Mikronaehrstoffe erfasst (7 Vitamine, 7 Mineralstoffe, mit
# Tageszielen); leer = niemand:
#   FOOD_MICRONUTRIENTS=torben
# Verzeichnis mit der Android-App (healthy.apk + latest.json):
#   FOOD_ANDROID_DIR=/opt/healthy-android
# Firebase-Dienstkonto fuer Push an Android (root:food 640):
#   FCM_SERVICE_ACCOUNT_FILE=/etc/fcm-healthy.json

# --- Push an iPhones ---------------------------------------------------------
# APNS_KEY_FILE, APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC wie im README ("Push").
# APNS_HOST ist der Sandbox-Rechner (Entwicklungs-Installationen und alle
# Kennungen ohne Umgebung). TestFlight-Kennungen gehen an den Produktions-
# Rechner; dessen Vorgabe stimmt und muss nicht gesetzt werden:
#   APNS_PRODUCTION_HOST=https://api.push.apple.com

# --- Interne Endpunkte (/api/internal/**) ------------------------------------
# Dienst-Token der Einkaufsliste: nur damit legt sie gekochte Rezepte als
# Gerichte an (POST /api/internal/recipe-dishes). Keine Person, oeffnet sonst
# nichts. Derselbe Wert steht in /etc/shopping.env; shopping/deploy/setup-recipes.sh
# erzeugt ihn (openssl rand -hex 32) und schreibt ihn in beide Dateien. Leer oder
# fehlend = der Endpunkt antwortet mit 404.
#   FOOD_RECIPE_TOKEN=<openssl rand -hex 32>
# /api/internal/push braucht nichts Eigenes: der Weight Tracker meldet sich mit
# dem Token der Eigentuemerin aus HEALTH_TOKENS.

# --- Feature Requests (deploy/setup-feature-requests.sh schreibt das) -------
# Claude entwirft die Story Card - ein eigener Agent, laeuft auf Felix' Claude-
# Login. Nur gesetzt, wenn die sudo-Probe des Setups klappt; leer = kein Entwurf,
# die Seite oeffnet den Editor leer:
#   FOOD_STORY_AGENT_COMMAND=/usr/bin/sudo -n -u flexii /home/flexii/services/story-agent/run-agent.sh
# Modell des Agenten (Vorgabe claude-sonnet-5). sudo reicht genau diese Variable
# an das Skript durch (deploy/sudoers-story-agent):
#   STORY_AGENT_MODEL=claude-haiku-4-5
# Wohin die Links der Unteraufgaben im To-Do zeigen (Vorgabe wie hier):
#   FOOD_FEATURE_REQUESTS_URL=https://fherrmann.com/feature-requests
# Der To-Do-Dienst (Vorgabe wie hier; leer = keine Unteraufgaben). Angemeldet
# wird mit FH_PRIVATE_TOKEN von oben:
#   FOOD_TODO_URL=http://127.0.0.1:48210/todo
# Wo die Anfragen liegen (Vorgabe relativ zu /opt/food):
#   FOOD_FEATURE_REQUESTS_FILE=data/feature-requests.json
